# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/ledger_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ledger_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ledger_db

# Clerk Authentication Secrets
# Found in Clerk Dashboard -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here

# Allowed Frontend Origins (comma-separated for CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Defaults
DEFAULT_CURRENCY=INR
DEFAULT_ZERO_BALANCE_ACTION=delete

