# Clerk Frontend Authentication
# Found in Clerk Dashboard -> API Keys -> Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key_here

# Backend API Base URL
# For local dev: leave blank (uses Vite proxy) or http://localhost:5000
# For Vercel production: set to your Render backend service URL
VITE_API_URL=https://your-backend.onrender.com

